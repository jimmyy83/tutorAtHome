# Local development defaults. Render values are configured in Render's environment.
PORT=4000
NODE_ENV=development
CORS_ORIGINS=http://localhost:5173
PUBLIC_API_URL=http://localhost:4000

# Production placeholders only: replace these with the deployed HTTPS origins.
# CORS_ORIGINS=https://<your-vercel-origin>
# PUBLIC_API_URL=https://<your-render-service-origin>

# Local MongoDB example. Set the real Atlas URI only in a protected environment.
MONGODB_URI=mongodb://127.0.0.1:27017/tutorathome
MONGODB_DB_NAME=tutorathome

# Use a private random value of at least 32 characters in production.
JWT_SECRET=replace-with-a-private-random-secret-at-least-32-characters
JWT_EXPIRES_IN=8h

# Only needed to bootstrap the first admin when the database has no admin account.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Production requires a supported provider and matching server-side secret.
CAPTCHA_PROVIDER=
CAPTCHA_SECRET=

# Image uploads are enabled in production and require all three Cloudinary values.
CLOUDINARY_ENABLED=false
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

FORM_RATE_LIMIT_MAX=5
FORM_RATE_LIMIT_WINDOW_MIN=15
