# Local backend defaults. Replace placeholders with private local values.
PORT=4000
NODE_ENV=development
CORS_ORIGINS=http://localhost:5173
PUBLIC_API_URL=http://localhost:4000
JWT_SECRET=replace-with-a-private-random-secret-of-at-least-32-characters
JWT_EXPIRES_IN=8h
MONGODB_URI=mongodb://127.0.0.1:27017/tutorathome
MONGODB_DB_NAME=tutorathome
ADMIN_EMAIL=admin@example.local
ADMIN_PASSWORD=replace-with-a-local-admin-password
CLOUDINARY_ENABLED=false
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
FORM_RATE_LIMIT_MAX=5
FORM_RATE_LIMIT_WINDOW_MIN=15
# Maximum size in megabytes for each teacher registration upload (profile, qualification, Aadhaar).
TEACHER_UPLOAD_MAX_MB=5
