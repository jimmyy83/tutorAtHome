PORT=4000
NODE_ENV=development
CORS_ORIGINS=http://localhost:5173
PUBLIC_API_URL=http://localhost:4000

# Replace with a private random value of at least 32 characters in production.
JWT_SECRET=replace-with-a-private-random-secret-at-least-32-characters
JWT_EXPIRES_IN=8h

# Local MongoDB example; use a protected environment variable for hosted deployments.
MONGODB_URI=mongodb://127.0.0.1:27017/tutorathome
MONGODB_DB_NAME=tutorathome

# Set initial admin credentials only in a private local/deployment environment.
ADMIN_EMAIL=admin@example.invalid
ADMIN_PASSWORD=replace-with-a-private-admin-password

# Production requires a supported provider (turnstile or recaptcha) and its server secret.
CAPTCHA_PROVIDER=
CAPTCHA_SECRET=

# Keep false for local development unless upload credentials are configured.
CLOUDINARY_ENABLED=false
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

FORM_RATE_LIMIT_MAX=5
FORM_RATE_LIMIT_WINDOW_MIN=15
